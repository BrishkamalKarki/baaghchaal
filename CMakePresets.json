{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [{
    "name": "debug-linux",
    "displayName": "Debug (unoptimized)",
    "generator": "Ninja",
    "binaryDir": "${sourceDir}/build_ln/build_debug",
    "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Debug",
      "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/bootstrap-vcpkg.cmake"
    }
  },
  {
    "name": "release-linux",
    "displayName": "Release (optimized)",
    "generator": "Ninja",
    "binaryDir": "${sourceDir}/build_ln/build_release",
    "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Release",
      "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/bootstrap-vcpkg.cmake"
    }
  },
  {
    "name": "debug-windows",
    "displayName": "Debug (unoptimized)",
    "generator": "Ninja",
    "binaryDir": "${sourceDir}/build_wn/build_debug",
    "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Debug",
      "CMAKE_TOOLCHAIN_FILE":"${sourceDir}/cmake/bootstrap-vcpkg.cmake"
    }
  },
  {
    "name": "release-windows",
    "displayName": "Release (optimized)",
    "generator": "Ninja",
    "binaryDir": "${sourceDir}/build_wn/build_release",
    "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Release",
      "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/bootstrap-vcpkg.cmake"
    }
  }],
  "buildPresets": [
    {
      "name": "debug-linux",
      "configurePreset": "debug-linux"
    },
    {
      "name": "release-linux",
      "configurePreset": "release-linux"
    },
    {
      "name": "debug-windows",
      "configurePreset": "debug-windows"
    },
    {
      "name": "release-windows",
      "configurePreset": "release-windows"
    }
  ]
}