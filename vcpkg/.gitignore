############################################################
# vcpkg/.gitignore
#
# Ignore generated files only.
# Keep all source files required to bootstrap vcpkg.
############################################################

# Generated executable after bootstrap
/vcpkg.exe
/vcpkg

# Installed packages and caches
/buildtrees/
/downloads/
/packages/
/installed/
/vcpkg_installed/
/archives/

# Temporary build files
/scripts/buildsystems/tmp/

# Generated logs
*.log

# Ignore generated archives
*.zip
*.7z
*.tar
*.gz

# Ignore generated package binaries only
*.nupkg

# Ignore editor files
.vscode/
.idea/
.DS_Store
*.swp

############################################################
# Keep all source files
############################################################

# Keep every script
!/scripts/**
!/ports/**
!/triplets/**
!/versions/**
!/docs/**
!/toolsrc/**
!/bootstrap-vcpkg.bat
!/bootstrap-vcpkg.sh
!/.vcpkg-root