.PHONY : src/timidity/timidity.s

# target to generate assembly for a file
src/timidity/timidity.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/SDL3_mixer-shared.dir/build.make CMakeFiles/SDL3_mixer-shared.dir/src/timidity/timidity.c.s
.PHONY : src/timidity/timidity.c.s

